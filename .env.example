# Copy to .env and fill in. .env is git-ignored.

POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=financeagent

# Comma-separated origins allowed by the backend API (* for dev)
CORS_ORIGINS=*

# Absolute Linux host path, mounted at exactly the same path in backend.
# Temporary native Docker analysis copies only; canonical files stay on workspaces.
# Backend receives Docker daemon authority: trusted local development only.
ANALYSIS_WORKSPACE_DIR=/tmp/financeagent-analysis

# Optional scripts/seed.sh development helper only; normal browser use saves
# credentials in PostgreSQL through the Credentials page, not these variables.
# DeepSeek official base: https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# SEC requests identify this application honestly. Set a real contact address
# for your deployment, following SEC fair-access guidance; do not impersonate
# a browser or invent a contact. Requests are rate-limited and cached.
SEC_USER_AGENT=FinanceAgent/0.1

# Embedding provider for the knowledge base (KB disabled until this exists;
# see docs/数据结构.md §8). DashScope text-embedding-v4 is the recommended
# native option; SiliconFlow bge-m3 works via the OpenAI-compatible layer.
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIM=1024
